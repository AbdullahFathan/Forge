APP_ENV=local
HTTP_PORT=8080

DATABASE_DSN=postgres://workspace:workspace@localhost:5432/workspace?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

BOOTSTRAP_ADMIN_EMAIL=admin@workspace.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin1

RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret
RUSTFS_BUCKET=workspace
RUSTFS_USE_SSL=false
